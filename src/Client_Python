import sys
import omniORB
from omniORB import CORBA

# Import the IDL files that were compiled by omniidl
from Idls import GameIDL
from Idls import AuthenticationIDL
from Shared_Files.PlayerAccount import PlayerAccount
from game_service import GameService
from game_lobby_controller import GameLobbyController
from game_room_controller import GameRoomController
from session_manager import SessionManager
from login_controller import LogInController
from login_page_model import LogInPageModel
from login_callback_service import LoginCallBackServiceImpl

# PlayerClient_Python class that handles CORBA interactions
class PlayerClient_Python:
    def __init__(self, orb, naming_context):
        self.orb = orb
        self.naming_context = naming_context

    def register_login_callback(self, callback_service_impl):
        # Example code: Assuming LoginCallbackService is already registered in CORBA
        callback_ref = self.naming_context.resolve_str("LoginCallbackService")
        callback_service = AuthenticationIDL.LoginCallbackServiceHelper.narrow(callback_ref)
        
        # Register the callback and return the reference
        callback_service.register_callback(callback_service_impl)
        return callback_service

# Function to connect to the server and get references
def connect_to_server():
    # Initialize the CORBA ORB
    orb = CORBA.ORB_init(sys.argv)
    
    # Resolve the Naming Service and get the context
    naming_service = orb.resolve_initial_references("NameService")
    naming_context = naming_service._narrow(CORBA.NamingContextExt)

    # Look up the CORBA object references for GameService and AuthenticationService
    game_service_ref = naming_context.resolve_str("GameService")
    auth_service_ref = naming_context.resolve_str("AuthenticationService")

    # Narrow the references to the appropriate CORBA interfaces
    game_service = GameIDL.GameServiceHelper.narrow(game_service_ref)
    auth_service = AuthenticationIDL.AuthenticationServiceHelper.narrow(auth_service_ref)

    print("Successfully connected to the server.")
    return orb, naming_context, game_service, auth_service

def main():
    # Connect to the server
    orb, naming_context, game_service, auth_service = connect_to_server()

    # Initialize PlayerClient_Python for handling CORBA interactions
    client = PlayerClient_Python(orb, naming_context)

    # Initialize SessionManager with the services
    SessionManager.init_services(game_service, auth_service)

    # Initialize the login model and controller
    login_page_model = LogInPageModel(auth_service)
    login_controller = LogInController(login_page_model, client)

    # Simulate user input (username and password via console)
    username = input("Enter username: ")
    password = input("Enter password: ")

    # Call the login controller to handle the login process
    login_controller.on_continue(username, password)

    # Retrieve the session token after successful login
    session_token = SessionManager.get_session_token()
    print(f"Logged in with session token: {session_token}")

    # Create a PlayerAccount object (example) and set it in the SessionManager
    player_account = PlayerAccount(1, username, password, 100)  # Example player
    SessionManager.set_logged_in_player(player_account)

    # Initialize controllers for game-related actions
    game_lobby_controller = GameLobbyController(game_service)
    game_room_controller = GameRoomController(game_service, SessionManager)

    # Example: Join a game lobby
    game_token = game_lobby_controller.join_lobby(player_account, session_token)
    SessionManager.set_game_token(game_token)
    print(f"Joined game lobby with game token: {game_token}")

    # Example: Start a round in the game
    round_number = 1
    game_room_controller.start_round(round_number)
    print(f"Started round {round_number} in the game.")

    # Example: Guess a letter in the game
    game_room_controller.guess_letter('A')
    print("Player guessed the letter 'A'.")

    # Example: Get the round winner
    winner = game_room_controller.get_round_winner()
    print(f"The winner of the round is: {winner}")

if __name__ == "__main__":
    main()
