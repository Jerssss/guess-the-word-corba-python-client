        print(f"Game Room Initialized for player {player_id}")

    def handle_guess(self, letter):
        print(f"[GameRoomController] handleGuess() for letter: {letter}")
        hits = self.model.guess_letter(self.game_token, self.player_id, self.session_token, letter)
        if not hits:
            self.remaining_lives -= 1
            print(f"[GameRoomController] Wrong guess. Remaining lives = {self.remaining_lives}")
            if self.remaining_lives <= 0:
                print("Game Over")
        else:
            print(f"Correct guess at positions: {hits}")


